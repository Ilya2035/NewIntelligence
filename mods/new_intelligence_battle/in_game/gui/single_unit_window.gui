				}

				# CW BEGIN headquarters tab (Concentrated Warfare)
				### HEADQUARTERS CONTENT - shown instead of the actions content while the tab variable says so (own armies
				# only: navies and foreign armies never get here, the tab row is hidden for them).
				# Data sources: scripted GUIs from in_game/common/scripted_guis/cw_scripted_guis.txt (scope = country, root =
				# player, scope:loc = the selected unit's location), the cached country variables written by cw_cache_limits
				# (cw_hq_count_v / cw_hq_limit_v / cw_colonial_hq_count_v / cw_colonial_hq_limit_v), the unit's own
				# sub-unit list and its timed modifiers. Visual building blocks are the templates the vanilla actions content
				# uses above.
				#
				# Scope note: Unit.MakeScope / scope = unit scripted GUIs are unverified in 1.4.7 (SPEC section 0, research 07
				# section 12.2), so the scripted GUIs only know the LOCATION of the selected army and answer for the player's
				# armies standing there. Everything that must be true for THIS army (its headquarters regiments, a lone
				# headquarters, the penalty actually in force) is therefore read from the unit's own data models
				# (GetSubUnits, GetTimedModifierOwner.GetModifiers); the location-scoped scripted GUIs are used only where
				# their answer is exact for this army too (no own headquarters army here at all, overseas ground) and for the
				# buttons, whose tooltips say that they act on the largest own army at this location.
				# CW TODO verify: SingleUnitWindow.GetSelectedUnit.MakeScope - if it works in 1.4.7, switch the scripted GUIs
				# to scope = unit so that the location-scoped row and the buttons target the selected army itself.
				vbox = {
					using = layoutpolicy_expanding
					margin = {5 5}
					spacing = 5

					visible = "[And(GetVariableSystem.HasValue( 'cw_unit_tab', 'headquarters' ), And(SingleUnitWindow.GetSelectedUnit.IsArmy, SingleUnitWindow.GetSelectedUnit.GetCountry.IsPlayer))]"
					datacontext = "[SingleUnitWindow.GetSelectedUnit]"

					### STATUS CARD - (1) rows per headquarters regiment of this army, (2) the penalty in force on this army,
					# (3) location rows; the vanilla modifier banner on the right lists every timed modifier of the unit.
					hbox = {
						layoutpolicy_horizontal = expanding
						minimumsize = { -1 45 }
						using = bg_paper_card
						using = bg_cabinet_card_frame

						vbox = {
							layoutpolicy_horizontal = expanding
							margin = { 10 5 }
							spacing = 3

							# (1) One row per headquarters regiment of THIS army - exact, independent of who else stands here.
							# flowcontainer + ignoreinvisible + datamodel: multi_unit_window.gui:229-241; direction = vertical +
							# ignoreinvisible: sub_unit_banner.gui:38-42. Every item holds exactly one child (a vbox) that is visible
							# for headquarters regiments and, in a one-regiment army, for that single regiment. Headquarters rows are
							# recognised by comparing the localized type name with the HQ unit types' own loc keys (EqualTo_string +
							# Localize, as the regiment markers further down; keep cw_hq / cw_hq_colonial unique in every language).
							# "Organised" = the right headquarters AND at least three regiments (cw_min_subunits_organized = 3: the staff
							# plus two others, cw_unit_is_organized, DESIGN 2.4); a colonial headquarters organises only on overseas ground,
							# and cw_sgui_loc_is_overseas answers for the selected army's own location, so that test is exact here. The size
							# test is the vanilla GreaterThan_int32(GetDataModelSize(...), '(int32)N') form (:3727 above,
							# GetDataModelSize(Unit.GetSubUnits): unit_overview.gui:2998). A merged army with several headquarters
							# shows one row per headquarters - the surplus one can be disbanded (DESIGN 2.5).
							# CW TODO verify: Unit.GetSubUnits as a datamodel with SubUnit items (see the regiment list below).
							flowcontainer = {
								direction = vertical
								ignoreinvisible = yes
								spacing = 3
								datamodel = "[SingleUnitWindow.GetSelectedUnit.GetSubUnits]"

								item = {
									vbox = {
										ignoreinvisible = yes
										spacing = 3
										visible = "[Or(Or(EqualTo_string(SubUnit.GetDefinition.GetNameWithNoTooltip, Localize('cw_hq')), And(EqualTo_string(SubUnit.GetDefinition.GetNameWithNoTooltip, Localize('cw_hq_colonial')), Or(Not(GreaterThan_int32(GetDataModelSize(SingleUnitWindow.GetSelectedUnit.GetSubUnits), '(int32)2')), GetScriptedGui('cw_sgui_loc_is_overseas').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('loc', SingleUnitWindow.GetSelectedUnit.GetLocation.MakeScope).End)))), Not(GreaterThan_int32(GetDataModelSize(SingleUnitWindow.GetSelectedUnit.GetSubUnits), '(int32)1')))]"

										# home headquarters in an army of three or more regiments: organised
										hbox = {
											visible = "[And(EqualTo_string(SubUnit.GetDefinition.GetNameWithNoTooltip, Localize('cw_hq')), GreaterThan_int32(GetDataModelSize(SingleUnitWindow.GetSelectedUnit.GetSubUnits), '(int32)2'))]"
											spacing = 7
											tooltip = "cw_hq_desc"
											icon = {
												size = { 24 24 }
												texture = "gfx/interface/icons/unit_actions/commander.dds"
											}
											text_single = {
												autoresize = yes
												align = left|nobaseline
												text = "CW_HQ_PRESENT"
												default_format = "#G"
											}
										}

										# colonial headquarters in an army of three or more regiments on OVERSEAS ground (cw_sgui_loc_is_overseas on this
										# army's own location): organised, with cw_expeditionary
										hbox = {
											visible = "[And(And(EqualTo_string(SubUnit.GetDefinition.GetNameWithNoTooltip, Localize('cw_hq_colonial')), GreaterThan_int32(GetDataModelSize(SingleUnitWindow.GetSelectedUnit.GetSubUnits), '(int32)2')), GetScriptedGui('cw_sgui_loc_is_overseas').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('loc', SingleUnitWindow.GetSelectedUnit.GetLocation.MakeScope).End))]"
											spacing = 7
											tooltip = "cw_hq_colonial_desc"
											icon = {
												size = { 24 24 }
												texture = "gfx/interface/icons/diplomatic_status/giving_send_officers.dds"
											}
											text_single = {
												autoresize = yes
												align = left|nobaseline
												text = "CW_HQ_COLONIAL_PRESENT"
												default_format = "#G"
											}
										}

										# (the same colonial headquarters outside its theatre - the siege-only tier - is the location row (3a') below,
										# driven by cw_sgui_loc_has_colonial_hq_at_home, so that a home headquarters in the same army, which organises
										# it, never shows a contradicting yellow row next to its green one)

										# a headquarters of either type in an army below three regiments (a lone staff, or staff + one regiment): not
										# organised, the penalty applies - neither a lone 100-man staff nor a two-regiment "siege detachment" may
										# occupy anything (SPEC section 15, research 15 section 7)
										hbox = {
											visible = "[And(Or(EqualTo_string(SubUnit.GetDefinition.GetNameWithNoTooltip, Localize('cw_hq')), EqualTo_string(SubUnit.GetDefinition.GetNameWithNoTooltip, Localize('cw_hq_colonial'))), Not(GreaterThan_int32(GetDataModelSize(SingleUnitWindow.GetSelectedUnit.GetSubUnits), '(int32)2')))]"
											spacing = 7
											tooltip = "STATIC_MODIFIER_DESC_cw_no_hq"
											icon = {
												size = { 24 24 }
												texture = "gfx/interface/icons/icon_warning.dds"
											}
											text_single = {
												autoresize = yes
												align = left|nobaseline
												text = "CW_HQ_LONE"
												default_format = "#R"
											}
										}

										# a one-regiment army whose single regiment is not a headquarters: not organised
										hbox = {
											visible = "[And(Not(Or(EqualTo_string(SubUnit.GetDefinition.GetNameWithNoTooltip, Localize('cw_hq')), EqualTo_string(SubUnit.GetDefinition.GetNameWithNoTooltip, Localize('cw_hq_colonial')))), Not(GreaterThan_int32(GetDataModelSize(SingleUnitWindow.GetSelectedUnit.GetSubUnits), '(int32)1')))]"
											spacing = 7
											tooltip = "STATIC_MODIFIER_DESC_cw_no_hq"
											icon = {
												size = { 24 24 }
												texture = "gfx/interface/icons/alerts_icons/army_without_leader.dds"
											}
											text_single = {
												autoresize = yes
												align = left|nobaseline
												text = "CW_HQ_NO_HQ"
												default_format = "#R"
											}
										}
									}
								}
							}

							# (2) The penalty actually in force on THIS army: one of the timed modifiers cw_no_hq / cw_no_hq_mild /
							# cw_no_hq_harsh (all three share the name STATIC_MODIFIER_NAME_cw_no_hq). Exact per army, but shown only
							# while an own ORGANISED army (the right headquarters for its ground AND three or more regiments - that is what
							# cw_sgui_loc_has_hq_army tests, cw_unit_is_organized) or an own siege-only army (colonial headquarters at
							# home, cw_sgui_loc_has_colonial_hq_at_home) stands here as well: the cases the location row (3a) cannot see or
							# withholds (a shared location, or a stale penalty on an army that just received a headquarters); everywhere
							# else row (3a) already says it and the modifier banner on the right lists the modifier anyway.
							# TimedModifierOwner.GetModifiers datamodel + TimedModifier.GetModifier.GetName: shared/modifiers.gui:96-108.
							# CW TODO verify: TimedModifier.GetModifier.GetName returns the plain localized name (no tooltip markup) so
							# that EqualTo_string matches; if this row never appears in game, try GetNameWithNoTooltip (verified on
							# StaticModifier in cooltip.gui:949, unverified on this chain).
							flowcontainer = {
								direction = vertical
								ignoreinvisible = yes
								datacontext = "[SingleUnitWindow.GetSelectedUnit.GetTimedModifierOwner]"
								datamodel = "[TimedModifierOwner.GetModifiers]"

								item = {
									hbox = {
										visible = "[And(EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_cw_no_hq')), And(Or(GetScriptedGui('cw_sgui_loc_has_hq_army').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('loc', SingleUnitWindow.GetSelectedUnit.GetLocation.MakeScope).End), GetScriptedGui('cw_sgui_loc_has_colonial_hq_at_home').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('loc', SingleUnitWindow.GetSelectedUnit.GetLocation.MakeScope).End)), GreaterThan_int32(GetDataModelSize(SingleUnitWindow.GetSelectedUnit.GetSubUnits), '(int32)1')))]"
										spacing = 7
										tooltip = "STATIC_MODIFIER_DESC_cw_no_hq"
										icon = {
											size = { 24 24 }
											texture = "gfx/interface/icons/alerts_icons/army_without_leader.dds"
										}
										text_single = {
											autoresize = yes
											align = left|nobaseline
											text = "CW_HQ_PENALISED"
											default_format = "#R"
										}
									}
									# the siege-only tier in force on THIS army (cw_no_hq_siege_only: a colonial headquarters outside its theatre) -
									# its own loc name, so the compare above never mistakes it for the no-headquarters penalty; shown whenever present
									hbox = {
										visible = "[EqualTo_string(TimedModifier.GetModifier.GetName, Localize('STATIC_MODIFIER_NAME_cw_no_hq_siege_only'))]"
										spacing = 7
										tooltip = "STATIC_MODIFIER_DESC_cw_no_hq_siege_only"
										icon = {
											size = { 24 24 }
											texture = "gfx/interface/icons/icon_warning.dds"
										}
										text_single = {
											autoresize = yes
											align = left|nobaseline
											text = "CW_HQ_SIEGE_ONLY"
											default_format = "#yellow_titles"
										}
									}
								}
							}

							# (3a) No own organised army at this location at all (cw_sgui_loc_has_hq_army = an own army with a
							# home headquarters, or a colonial one on overseas ground, and three or more regiments - the script's own
							# cw_unit_is_organized test): with two or more regiments this army is then certainly not organised - exact
							# for this army, whoever else
							# stands here. Hidden for exiled armies (exempt, SPEC section 15 - prisoner-only
							# stacks are exempt too but cannot be told apart in the GUI, so the text claims no penalty), at sea (the
							# location is a sea zone) and for one-regiment armies (row (1) already says it). Also withheld while an own
							# siege-only army stands here (row (3a') below says what applies; a co-located HQ-less army still shows its
							# penalty through row (2)).
							hbox = {
								visible = "[And(Not(GetScriptedGui('cw_sgui_loc_has_hq_army').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('loc', SingleUnitWindow.GetSelectedUnit.GetLocation.MakeScope).End)), And(Not(GetScriptedGui('cw_sgui_loc_has_colonial_hq_at_home').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('loc', SingleUnitWindow.GetSelectedUnit.GetLocation.MakeScope).End)), And(Not(SingleUnitWindow.GetSelectedUnit.IsExiled), And(Not(SingleUnitWindow.GetSelectedUnit.IsInTransport), GreaterThan_int32(GetDataModelSize(SingleUnitWindow.GetSelectedUnit.GetSubUnits), '(int32)1')))))]"
								spacing = 7
								tooltip = "STATIC_MODIFIER_DESC_cw_no_hq"
								icon = {
									size = { 24 24 }
									texture = "gfx/interface/icons/alerts_icons/army_without_leader.dds"
								}
								text_single = {
									autoresize = yes
									align = left|nobaseline
									text = "CW_HQ_ABSENT_LOC"
									default_format = "#R"
								}
								expand = {}
							}

							# (3a') An own army whose only headquarters is colonial stands here on non-overseas ground with three or more
							# regiments (cw_sgui_loc_has_colonial_hq_at_home -> cw_unit_has_colonial_hq_at_home): the siege-only tier
							# (cw_no_hq_siege_only, DESIGN 2.4) - it fights at full strength but cannot besiege here; "Place headquarters
							# here" adds a home headquarters to it (cw_sgui_loc_add_hq: no home HQ). Hidden while an organised army stands
							# here as well (row (2) then shows what is in force on this army), at sea and for exiled armies.
							hbox = {
								visible = "[And(GetScriptedGui('cw_sgui_loc_has_colonial_hq_at_home').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('loc', SingleUnitWindow.GetSelectedUnit.GetLocation.MakeScope).End), And(Not(GetScriptedGui('cw_sgui_loc_has_hq_army').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('loc', SingleUnitWindow.GetSelectedUnit.GetLocation.MakeScope).End)), And(Not(SingleUnitWindow.GetSelectedUnit.IsExiled), Not(SingleUnitWindow.GetSelectedUnit.IsInTransport))))]"
								spacing = 7
								tooltip = "STATIC_MODIFIER_DESC_cw_no_hq_siege_only"
								icon = {
									size = { 24 24 }
									texture = "gfx/interface/icons/diplomatic_status/giving_send_officers.dds"
								}
								text_single = {
									autoresize = yes
									align = left|nobaseline
									text = "CW_HQ_COLONIAL_AT_HOME"
									default_format = "#yellow_titles"
								}
								expand = {}
							}

							# (3b) Exiled army: the headquarters rules never touch it (cw_unit_is_exempt). IsExiled: vanilla :3838.
							hbox = {
								visible = "[SingleUnitWindow.GetSelectedUnit.IsExiled]"
								spacing = 7
								icon = {
									size = { 24 24 }
									texture = "gfx/interface/icons/unit_view/exiles.dds"
								}
								text_single = {
									autoresize = yes
									align = left|nobaseline
									text = "CW_HQ_EXEMPT"
									default_format = "#yellow_titles"
								}
								expand = {}
							}

							# (3c) Embarked army: its location is a sea zone, so the location rows and the buttons are withheld
							# until it lands. IsInTransport + transport_troops icon: vanilla :3730-3734.
							hbox = {
								visible = "[SingleUnitWindow.GetSelectedUnit.IsInTransport]"
								spacing = 7
								icon = {
									size = { 24 24 }
									texture = "gfx/interface/icons/military_objectives/transport_troops.dds"
								}
								text_single = {
									autoresize = yes
									align = left|nobaseline
									text = "CW_HQ_AT_SEA"
									default_format = "#yellow_titles"
								}
								expand = {}
							}

							# (3d) The army stands on an overseas continent (would_be_overseas_for the player): colonial HQ territory
							hbox = {
								visible = "[And(GetScriptedGui('cw_sgui_loc_is_overseas').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('loc', SingleUnitWindow.GetSelectedUnit.GetLocation.MakeScope).End), Not(SingleUnitWindow.GetSelectedUnit.IsInTransport))]"
								spacing = 7
								tooltip = "game_concept_cw_colonial_headquarters_desc"
								icon = {
									size = { 24 24 }
									texture = "gfx/interface/icons/flat_icons/overseas.dds"
								}
								text_single = {
									autoresize = yes
									align = left|nobaseline
									text = "CW_HQ_OVERSEAS"
									default_format = "#yellow_titles"
								}
								expand = {}
							}
						}

						expand = {}

						# The unit's timed modifiers (cw_no_hq / cw_expeditionary ...) with their native icons and tooltips;
						# verbatim copy of the vanilla status strip widget further up in this file (:3723-3728).
						widget = {
							size = { 50 20 }
							datacontext = "[SingleUnitWindow.GetSelectedUnit.GetTimedModifierOwner]"
							visible = "[GreaterThan_int32(GetDataModelSize(TimedModifierOwner.GetModifiers), '(int32)0')]"
							OneOrSeveralTimedModifiers = {}
						}
					}

					### PENALTY EXPLANATION - loc text without numbers (the game rule cw_rule_hq_penalty selects one of three
					# modifier variants, cw_effects.txt cw_apply_no_hq_penalty, and the GUI cannot read the active rule); the
					# tooltip lists the real numbers of all three static modifiers under the rule's setting names, the live
					# variant is the modifier icon on the army (status card above).
					# GetModifier('key').GetDesc inside TooltipRowList: panels/situation/western_schism.gui:222-226; several
					# children in one tooltip_content block: panels/situation/little_ice_age.gui:54-65.
					# CW TODO verify: GetModifier('cw_no_hq').GetDesc - vanilla uses it on location- and religion-category static
					# modifiers (harsh_winters_modifier in static_modifiers/location.txt, western_schism_modifier in
					# static_modifiers/religion.txt); the unit category (game_data = { category = unit }) is untested.
					text_multi = {
						layoutpolicy_horizontal = expanding
						autoresize = yes
						margin = { 5 2 }
						align = left|nobaseline
						fontsize = 14
						default_format = "#overview_text"
						text = "CW_HQ_PENALTY_INFO"

						tooltipwidget = {
							ContextualTooltipType = {
								blockoverride "title_icon" {
									icon = {
										using = tooltip_title_icon_size
										texture = "gfx/interface/icons/alerts_icons/army_without_leader.dds"
									}
								}
								blockoverride "title_text" {
									text = "STATIC_MODIFIER_NAME_cw_no_hq"
								}
								blockoverride "tooltip_content" {
									text_multi = {
										margin = { 15 0 }
										layoutpolicy_horizontal = expanding
										max_width = 500
										autoresize = yes
										text = "STATIC_MODIFIER_DESC_cw_no_hq"
									}
									TooltipRowList = {
										blockoverride "block_title" {
											text = "setting_cw_hq_penalty_standard"
										}
										textcontext = "[GetModifier('cw_no_hq').GetDesc]"
									}
									TooltipRowList = {
										blockoverride "block_title" {
											text = "setting_cw_hq_penalty_mild"
										}
										textcontext = "[GetModifier('cw_no_hq_mild').GetDesc]"
									}
									TooltipRowList = {
										blockoverride "block_title" {
											text = "setting_cw_hq_penalty_harsh"
										}
										textcontext = "[GetModifier('cw_no_hq_harsh').GetDesc]"
									}
								}
							}
						}
					}

					### SLOTS - "used / limit" pills from the cached country variables (same pill style as the vanilla
					# maintenance row above: bg_text_mask_container_brown inside a paper card). The variables are written by
					# cw_cache_limits (monthly pulse, war start / end, new age, and by the three buttons below right after their
					# effect); a headquarters recruited in the army builder or lost in battle shows up at the next pass, which
					# the tooltips say. Until the first pass runs the pill shows "-/-" (GetValue on an unset variable is
					# unverified, so IsSet is checked first).
					hbox = {
						layoutpolicy_horizontal = expanding
						minimumsize = { -1 45 }
						using = bg_paper_card
						using = bg_cabinet_card_frame

						# home headquarters: count / limit
						hbox = {
							spacing = 5
							using = layoutpolicy_expanding
							using = bg_text_mask_container_brown
							tooltip = "CW_HQ_SLOTS_TAB_TT"

							expand = {}

							icon = {
								size = { 30 30 }
								texture = "gfx/interface/icons/unit_actions/commander.dds"
							}
							text_single = {
								autoresize = yes
								align = nobaseline
								text = "CW_HQ_SLOTS"
							}
							text_single = {
								visible = "[GetPlayer.MakeScope.GetVariable('cw_hq_limit_v').IsSet]"
								autoresize = yes
								align = nobaseline
								default_format = "#yellow_titles"
								raw_text = "[GetPlayer.MakeScope.GetVariable('cw_hq_count_v').GetValue|0]/[GetPlayer.MakeScope.GetVariable('cw_hq_limit_v').GetValue|0]"
							}
							text_single = {
								visible = "[Not(GetPlayer.MakeScope.GetVariable('cw_hq_limit_v').IsSet)]"
								autoresize = yes
								align = nobaseline
								default_format = "#yellow_titles"
								raw_text = "-/-"
							}

							expand = {}
						}

						# colonial headquarters: count / limit - once colonial HQs are available at all (cw_sgui_loc_add_colonial_hq
						# is_shown = cached colonial limit > 0) OR while the country still owns colonial HQ regiments after losing
						# its theatre (limit 0, count > 0: the pill then reads e.g. 1/0, which is exactly what the player needs).
						# GreaterThan_CFixedPoint on GetVariable(...).GetValue: GetValue is a CFixedPoint (Multiply_CFixedPoint on it in
						# panels/disaster), literal form '(CFixedPoint)0' from main_menu/gui/scripted_widgets/_scripted_widgets.info.
						hbox = {
							visible = "[Or(GetScriptedGui('cw_sgui_loc_add_colonial_hq').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('loc', SingleUnitWindow.GetSelectedUnit.GetLocation.MakeScope).End), And(GetPlayer.MakeScope.GetVariable('cw_colonial_hq_count_v').IsSet, GreaterThan_CFixedPoint(GetPlayer.MakeScope.GetVariable('cw_colonial_hq_count_v').GetValue, '(CFixedPoint)0')))]"
							spacing = 5
							using = layoutpolicy_expanding
							using = bg_text_mask_container_brown
							blockoverride "text_mask_extra" {
								alpha = 0.1
							}
							tooltip = "CW_HQ_COLONIAL_SLOTS_TAB_TT"

							expand = {}

							icon = {
								size = { 30 30 }
								texture = "gfx/interface/icons/flat_icons/overseas.dds"
							}
							text_single = {
								autoresize = yes
								align = nobaseline
								text = "CW_HQ_COLONIAL_SLOTS"
							}
							text_single = {
								visible = "[GetPlayer.MakeScope.GetVariable('cw_colonial_hq_limit_v').IsSet]"
								autoresize = yes
								align = nobaseline
								default_format = "#yellow_titles"
								raw_text = "[GetPlayer.MakeScope.GetVariable('cw_colonial_hq_count_v').GetValue|0]/[GetPlayer.MakeScope.GetVariable('cw_colonial_hq_limit_v').GetValue|0]"
							}
							text_single = {
								visible = "[Not(GetPlayer.MakeScope.GetVariable('cw_colonial_hq_limit_v').IsSet)]"
								autoresize = yes
								align = nobaseline
								default_format = "#yellow_titles"
								raw_text = "-/-"
							}

							expand = {}
						}
					}

					### ACTIONS - add / add colonial / remove. enabled = is_valid, click = effect of the scripted GUI
					# (button_regular: loading_screen/gui/shared/defaults.gui:385; onclick as in advances_lateralview.gui:747;
					# IsValid/Execute as in economy_lateralview.gui:444; LeftClickButtonTooltip: attribute_columns/country.gui:260).
					# The whole row is withheld at sea (the location is a sea zone: cw_loc_add_hq would plant a headquarters into a
					# stack on a transport) and for exiled armies (exempt; the status card says why).
					hbox = {
						visible = "[And(Not(SingleUnitWindow.GetSelectedUnit.IsInTransport), Not(SingleUnitWindow.GetSelectedUnit.IsExiled))]"
						layoutpolicy_horizontal = expanding
						spacing = 5

						# "Place headquarters here": is_valid = free home slot (engine counter vs cw_hq_limit, which only reads
						# num_locations / the age - cheap) AND an own non-exempt army without HQ at the location.
						button_regular = {
							layoutpolicy_horizontal = expanding
							size = { -1 30 }
							text = "CW_HQ_ADD"
							enabled = "[GetScriptedGui('cw_sgui_loc_add_hq').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('loc', SingleUnitWindow.GetSelectedUnit.GetLocation.MakeScope).End)]"
							onclick = "[GetScriptedGui('cw_sgui_loc_add_hq').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('loc', SingleUnitWindow.GetSelectedUnit.GetLocation.MakeScope).End)]"
							tooltipwidget = {
								LeftClickButtonTooltip = {
									blockoverride "onclick_text" {
										text = "CW_HQ_ADD_RULES_TT"
									}
								}
							}
						}

						# "Place colonial headquarters here". Deliberately NOT gated on cw_sgui_loc_add_colonial_hq.IsValid: that
						# is_valid evaluates cw_colonial_hq_limit (cw_limit_values.txt), i.e. up to ~15 any_owned_location passes
						# over every owned location, and a GUI enabled= binding is re-evaluated on every update of the widget -
						# a late-game colonial empire would pay thousands of trigger evaluations per frame while this tab is open.
						# Instead: visible = colonial HQs exist at all (cached limit > 0) AND the location is overseas;
						# enabled = a free slot according to the cached counters (count < limit) AND no own organised army stands
						# here yet (the effect cw_loc_add_colonial_hq picks the largest HQ-less own army here). The effect itself
						# re-checks the live limit (cw_has_free_colonial_hq_slot) and refreshes the cached counters afterwards, so a
						# stale month can only make a click do nothing.
						button_regular = {
							visible = "[And(GetScriptedGui('cw_sgui_loc_add_colonial_hq').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('loc', SingleUnitWindow.GetSelectedUnit.GetLocation.MakeScope).End), GetScriptedGui('cw_sgui_loc_is_overseas').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('loc', SingleUnitWindow.GetSelectedUnit.GetLocation.MakeScope).End))]"
							layoutpolicy_horizontal = expanding
							size = { -1 30 }
							text = "CW_HQ_ADD_COLONIAL"
							enabled = "[And(GreaterThan_CFixedPoint(GetPlayer.MakeScope.GetVariable('cw_colonial_hq_limit_v').GetValue, GetPlayer.MakeScope.GetVariable('cw_colonial_hq_count_v').GetValue), Not(GetScriptedGui('cw_sgui_loc_has_hq_army').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('loc', SingleUnitWindow.GetSelectedUnit.GetLocation.MakeScope).End)))]"
							onclick = "[GetScriptedGui('cw_sgui_loc_add_colonial_hq').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('loc', SingleUnitWindow.GetSelectedUnit.GetLocation.MakeScope).End)]"
							tooltipwidget = {
								LeftClickButtonTooltip = {
									blockoverride "onclick_text" {
										text = "CW_HQ_ADD_COLONIAL_RULES_TT"
									}
								}
							}
						}

						# "Disband headquarters": is_valid = an own army with a headquarters at the location (one any_unit_in_location
						# scan). The effect strips every home headquarters regiment of the largest such army (colonial ones on a
						# later click) and disbands a headquarters-only army entirely - the tooltip warns about both.
						button_regular = {
							layoutpolicy_horizontal = expanding
							size = { -1 30 }
							text = "CW_HQ_REMOVE"
							enabled = "[GetScriptedGui('cw_sgui_loc_remove_hq').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('loc', SingleUnitWindow.GetSelectedUnit.GetLocation.MakeScope).End)]"
							onclick = "[GetScriptedGui('cw_sgui_loc_remove_hq').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('loc', SingleUnitWindow.GetSelectedUnit.GetLocation.MakeScope).End)]"
							tooltipwidget = {
								LeftClickButtonTooltip = {
									blockoverride "onclick_text" {
										text = "CW_HQ_REMOVE_WARNING_TT"
									}
								}
							}
						}
					}

					### REGIMENTS - every regiment of the army; headquarters regiments carry a marker icon.
					# Rows are a trimmed copy of the vanilla regiment row of the actions content (same paper card, illustration,
					# names and strength pill). HQ rows are recognised by comparing the localized type name with the HQ unit
					# types' own loc keys (cw_hq / cw_hq_colonial), the only type test available to the GUI
					# (EqualTo_string + Localize: both verified; keep those two loc strings unique in every language).
					# CW TODO verify: Unit.GetSubUnits as a datamodel with SubUnit items - GetDataModelSize(Unit.GetSubUnits) is
					# vanilla (unit_overview.gui:2998), but no vanilla list binds it with SubUnit.* item functions. Test: open an
					# army, the list must show its regiments and error.log must stay free of "Could not find data system function"
					# for GetSubUnits. If it fails, replace the two expressions here and in the status card by the vanilla datamodel
					# "[SingleUnitWindow.GetSubUnits]" (vanilla :4742; note that this list is the one fed by
					# SingleUnitWindow.GetSubUnitsSortSearch, so a search filter typed on the Actions tab would also filter it).
					scroll_list = {
						using = layoutpolicy_expanding

						blockoverride "scroll_list_setup" {
							using = layoutpolicy_expanding
							scrollbarpolicy_horizontal = always_off

							scrollbar_vertical = {
								using = Scrollbar_Vertical_Small
							}
						}

						blockoverride "scroll_list_is_empty" {
							visible = "[IsDataModelEmpty(SingleUnitWindow.GetSelectedUnit.GetSubUnits)]"
						}

						blockoverride "scroll_list_is_empty_text" {
							text = "SUBUNITS_SCROLL_LIST_EMPTY"
						}

						blockoverride "scroll_list_content" {
							addcolumn = 100%
							addrow = 55

							datamodel = "[SingleUnitWindow.GetSelectedUnit.GetSubUnits]"
							item = {
								widget = {
									using = bg_paper_card
									tooltipwidget = {
										using = SubUnit_tooltip
									}
									parentanchor = hcenter
									size = { 97% 50 }

									hbox = {
										margin = { 2 2 }
										hbox = {
											layoutpolicy_horizontal = expanding
											layoutpolicy_vertical = expanding
											spacing = 7
											datacontext = "[SubUnit.GetDefinition]"

											# illustration (template at the end of this file, needs the SubUnitType context above)
											widget = {
												layoutpolicy_vertical = expanding
												size = {37 -1}

												using = subunit_illustration
											}

											vbox = {
												layoutpolicy_horizontal = expanding
												layoutpolicy_vertical = expanding
												text_single = {
													layoutpolicy_horizontal = expanding
													align = left|nobaseline
													autoresize = no
													size = { -1 15 }
													text = "[SubUnit.GetDefinition.GetNameWithNoTooltip]"
													default_format = "#yellow_titles"
												}
												text_single = {
													layoutpolicy_horizontal = expanding
													align = left|nobaseline
													size = { -1 15 }
													maximumsize = {-1 15}
													fontsize = 12
													text = "[SubUnit.GetNameWithNoTooltip]"
													default_format = "#medium"
												}
											}

											# headquarters marker
											icon = {
												size = {35 35}
												texture = "gfx/interface/icons/unit_actions/commander.dds"
												visible = "[EqualTo_string(SubUnit.GetDefinition.GetNameWithNoTooltip, Localize('cw_hq'))]"
												tooltip = "cw_hq_desc"

												glow = {
													name = "drop_shadow"
													glow_radius = 3
													color = {0.0 0.0 0.0 1.0}
													alpha = 0.2
												}
											}

											# colonial headquarters marker
											icon = {
												size = {35 35}
												texture = "gfx/interface/icons/flat_icons/overseas.dds"
												visible = "[EqualTo_string(SubUnit.GetDefinition.GetNameWithNoTooltip, Localize('cw_hq_colonial'))]"
												tooltip = "cw_hq_colonial_desc"

												glow = {
													name = "drop_shadow"
													glow_radius = 3
													color = {0.0 0.0 0.0 1.0}
													alpha = 0.2
												}
											}

											# strength
											hbox = {
												margin = {0 5}
												layoutpolicy_vertical = expanding
												hbox = {
													spacing = 2
													margin = {5 0}
													layoutpolicy_vertical = expanding
													using = bg_text_mask_container_brown
													using = bg_frame_squared_brown
													blockoverride "text_mask_extra" {
														alpha = 0.4
													}
													blockoverride "frame_squared_extra" {
														alpha = 0.7
													}
													text_single = {
														align = right|nobaseline
														autoresize = no
														size = {60 15}
														raw_text = "[SubUnit.GetStrength]@army_strength!"
													}
												}
											}
										}
									}
								}
