																					}
		
																					sort_by_highlight = {
																						name = "strength"
																					}
																				}
																				
																				text_single = {
																					visible = "[And3(SubUnit.IsShip, Not(SubUnit.IsLevy), Not(EqualTo_CFixedPoint(SubUnit.GetMissingStrength, '(CFixedPoint)0')))]"
																					align = right|nobaseline
																					autoresize = no
																					size = {60 15}
																					raw_text = "[SubUnit.GetStrength]@navy_strength!"
																					default_format = "#R"
		
