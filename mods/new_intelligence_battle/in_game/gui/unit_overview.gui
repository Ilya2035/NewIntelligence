							}

							# CW BEGIN levy button (New Intelligence: Battle, v0.5, user review 2026-11-05): after the war the same
							# button disbands every army levy (vanilla offers that only as a right click on the levies card); at war it
							# raises them as before. Vanilla: enabled = "[Player.GetDiplomacy.IsAtWar]" and no peace branch.
							enabled = "[Or(Player.GetDiplomacy.IsAtWar, UnitOverview.CanDisbandAllLevies('(bool)yes'))]"

							action_tooltip = {
								click_type = left
								click_mode = confirm

								visible = "[Not(Player.GetDiplomacy.IsAtWar)]"
								enabled = "[UnitOverview.CanDisbandAllLevies('(bool)yes')]"
								description = "[UnitOverview.DisbandAllLeviesInfo('(bool)yes')]"
								title = "DISBAND_ALL_LEVIES"
								on_action = "[UnitOverview.DisbandAllLevies('(bool)yes')]"
							}

							action_tooltip = {
								click_type = left
								click_mode = confirm
								visible = "[Player.GetDiplomacy.IsAtWar]"

								enabled = "[And(Player.GetDiplomacy.IsAtWar, UnitOverview.CanRaiseAllLevies('(bool)yes'))]"
								conditions = "[UnitOverview.RaiseAllLeviesInfo('(bool)yes')]"
								title = "RAISE_ALL_LEVIES_CAPITAL"
								on_action = "[UnitOverview.RaiseAllLevies('(bool)yes')]"
							}

							action_tooltip = {
								click_type = right
								click_mode = single
								visible = "[Player.GetDiplomacy.IsAtWar]"

								enabled = "[And(Player.GetDiplomacy.IsAtWar, UnitOverview.CanRaiseAllLevies('(bool)yes'))]"
								conditions = "[UnitOverview.RaiseAllLeviesInfo('(bool)yes')]"
								title = "RAISE_ALL_LEVIES_SELECT_RALLY_POINT"
								on_action = "[SelectLocationToRaiseAllArmyLevies()]"
							}
