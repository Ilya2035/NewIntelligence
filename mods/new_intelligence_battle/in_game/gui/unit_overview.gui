lateralview = {
	name = "unit_overview"
	widgetid = "unit_overview"

	blockoverride "lateralview_topbuttons_extra" {
		widget = {
			parentanchor = vcenter
			size = { 40 40 }
			position = { 30 0 }

			button_automation_shortcut = {
				parentanchor = vcenter
				size = { 25 25 }


				action_tooltip = {
					title = "OPEN_AUTOMATION_PANEL_FILTER"
					on_action = "[OpenLateralViewWithFilter('automation', 'automation_filter_military')]"
				}

				tooltipwidget = { BasicFunctionalTooltip = {} }
			}
		}
	}

	blockoverride "panel_header" {
		window_header_alt = {
			blockoverride "header_text" {
				text = "MILITARY_TAB"
			}
			blockoverride "window_header_alt_color_texture"{
				using = color_military_texture
			}
		}
	}

	blockoverride "panel_content" {
		header_main_tabs = {
			blockoverride "content" {
				using = military_main_tabs
			}
		}

		# CW BEGIN headquarters tab content (New Intelligence: Battle)
		# Third tab of the Military panel ("subtab" = cw_hq; the vanilla army / navy contents are gated by their own values
		# and hide themselves). Reuses the types of in_game/gui/cw_hq_overview.gui (cw_hq_counter, cw_hq_army_row,
		# template cw_ov_number_text). Fixed sizes / autoresize only; the list sits in the vanilla scrollbox type.
		vbox = {
			visible = "[UnitOverview.Vars.HasValue( 'subtab', 'cw_hq' )]"
			using = layoutpolicy_expanding
			using = window_main_tabs_margin_alt
			using = bg_main_inner_image_alt
			blockoverride "image" {
				texture = "gfx/interface/illustrations/bg/bg_military.dds"
			}

			vbox = {
				using = layoutpolicy_expanding
				spacing = 8
				margin = { 8 8 }

				# ---- headquarters: used / limit ----
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 10

					cw_hq_counter = {
						blockoverride "cw_counter_tooltip" { tooltip = "CW_HQ_SLOTS_TT" }
						blockoverride "cw_counter_icon" { texture = "gfx/interface/icons/cw/cw_hq.dds" }
						blockoverride "cw_counter_label" { text = "CW_HQ_SLOTS" }
						blockoverride "cw_counter_count" {
							text_single = {
								using = cw_ov_number_text
								visible = "[GetPlayer.MakeScope.GetVariable('cw_hq_count_v').IsSet]"
								text = "[GetPlayer.MakeScope.GetVariable('cw_hq_count_v').GetValue|0]"
							}
							text_single = {
								using = cw_ov_number_text
								visible = "[Not(GetPlayer.MakeScope.GetVariable('cw_hq_count_v').IsSet)]"
								raw_text = "0"
							}
						}
						blockoverride "cw_counter_limit" {
							text_single = {
								using = cw_ov_number_text
								visible = "[GetPlayer.MakeScope.GetVariable('cw_hq_limit_v').IsSet]"
								text = "[GetPlayer.MakeScope.GetVariable('cw_hq_limit_v').GetValue|0]"
							}
							text_single = {
								using = cw_ov_number_text
								visible = "[Not(GetPlayer.MakeScope.GetVariable('cw_hq_limit_v').IsSet)]"
								raw_text = "0"
							}
						}
					}

					cw_hq_counter = {
						blockoverride "cw_counter_tooltip" { tooltip = "CW_HQ_COLONIAL_SLOTS_TT" }
						blockoverride "cw_counter_icon" { texture = "gfx/interface/icons/flat_icons/overseas.dds" }
						blockoverride "cw_counter_label" { text = "CW_HQ_COLONIAL_SLOTS" }
						blockoverride "cw_counter_count" {
							text_single = {
								using = cw_ov_number_text
								visible = "[GetPlayer.MakeScope.GetVariable('cw_colonial_hq_count_v').IsSet]"
								text = "[GetPlayer.MakeScope.GetVariable('cw_colonial_hq_count_v').GetValue|0]"
							}
							text_single = {
								using = cw_ov_number_text
								visible = "[Not(GetPlayer.MakeScope.GetVariable('cw_colonial_hq_count_v').IsSet)]"
								raw_text = "0"
							}
						}
						blockoverride "cw_counter_limit" {
							text_single = {
								using = cw_ov_number_text
								visible = "[GetPlayer.MakeScope.GetVariable('cw_colonial_hq_limit_v').IsSet]"
								text = "[GetPlayer.MakeScope.GetVariable('cw_colonial_hq_limit_v').GetValue|0]"
							}
							text_single = {
								using = cw_ov_number_text
								visible = "[Not(GetPlayer.MakeScope.GetVariable('cw_colonial_hq_limit_v').IsSet)]"
								raw_text = "0"
							}
						}
					}
				}

				# ---- formation clock (forming / formed) ----
				hbox = {
					visible = "[Or(Or(GetPlayer.MakeScope.GetVariable('cw_hq_forming_started').IsSet, GetPlayer.MakeScope.GetVariable('cw_hq_ready').IsSet), Or(GetPlayer.MakeScope.GetVariable('cw_colonial_hq_forming_started').IsSet, GetPlayer.MakeScope.GetVariable('cw_colonial_hq_ready').IsSet))]"
					layoutpolicy_horizontal = expanding
					spacing = 7
					margin = { 10 4 }
					using = bg_text_mask_container_brown

					icon = {
						size = { 24 24 }
						texture = "gfx/interface/icons/cw/cw_hq.dds"
					}
					vbox = {
						layoutpolicy_horizontal = expanding
						text_single = {
							visible = "[GetPlayer.MakeScope.GetVariable('cw_hq_ready').IsSet]"
							autoresize = yes
							align = left|nobaseline
							text = "CW_MIL_HQ_READY"
							default_format = "#G"
							tooltip = "CW_HQ_READY_TT"
						}
						text_single = {
							visible = "[And(GetPlayer.MakeScope.GetVariable('cw_hq_forming_started').IsSet, Not(GetPlayer.MakeScope.GetVariable('cw_hq_ready').IsSet))]"
							autoresize = yes
							align = left|nobaseline
							text = "CW_HQ_FORMING"
							tooltip = "CW_HQ_FORMING_TT"
						}
						text_single = {
							visible = "[GetPlayer.MakeScope.GetVariable('cw_colonial_hq_ready').IsSet]"
							autoresize = yes
							align = left|nobaseline
							text = "CW_HQ_COLONIAL_READY"
							default_format = "#G"
							tooltip = "CW_HQ_READY_TT"
						}
						text_single = {
							visible = "[And(GetPlayer.MakeScope.GetVariable('cw_colonial_hq_forming_started').IsSet, Not(GetPlayer.MakeScope.GetVariable('cw_colonial_hq_ready').IsSet))]"
							autoresize = yes
							align = left|nobaseline
							text = "CW_HQ_COLONIAL_FORMING"
							tooltip = "CW_HQ_FORMING_TT"
						}
					}
					expand = {}
				}

				# ---- v0.4: form the formed headquarters as a separate unit in the capital ----
				button_regular = {
					visible = "[GetPlayer.MakeScope.GetVariable('cw_hq_ready').IsSet]"
					layoutpolicy_horizontal = expanding
					size = { -1 30 }
					text = "CW_HQ_FORM_AT_CAPITAL"
					tooltip = "CW_HQ_FORM_AT_CAPITAL_TT"
					enabled = "[GetScriptedGui('cw_sgui_form_hq_at_capital').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					onclick = "[GetScriptedGui('cw_sgui_form_hq_at_capital').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}

				# ---- automation toggle ----
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 8
					margin = { 10 4 }
					using = bg_text_mask_container_brown

					button_checkbox = {
						size = { 22 22 }
						down = "[GetScriptedGui('cw_sgui_auto_hq_on').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						enabled = "[GetScriptedGui('cw_sgui_toggle_auto_hq').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						onclick = "[GetScriptedGui('cw_sgui_toggle_auto_hq').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						tooltip = "CW_AUTO_HQ_TT"
					}
					text_single = {
						autoresize = yes
						align = left|nobaseline
						default_format = "#overview_text"
						text = "[Select_CString(GetScriptedGui('cw_sgui_auto_hq_on').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Localize('CW_AUTO_HQ_ON'), Localize('CW_AUTO_HQ_OFF'))]"
						tooltip = "CW_AUTO_HQ_TT"
					}
					expand = {}
				}

				divider_solid_gold = {}

				# ---- v0.5 (user review 2026-11-05): ONE scroll area for "My headquarters" and the orders to subjects ----
				scrollbox = {
					using = layoutpolicy_expanding

					blockoverride "scrollbox_content" {
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 6
							margin = { 4 4 }

							# Collapsible header (client-side flag, default open)
							button_regular = {
								layoutpolicy_horizontal = expanding
								size = { -1 30 }
								text = "[Select_CString(GetVariableSystem.Exists('cw_mil_hq_list_closed'), Localize('CW_MIL_MY_HQS_CLOSED'), Localize('CW_MIL_MY_HQS_OPEN'))]"
								tooltip = "CW_MIL_MY_HQS_TT"
								onclick = "[GetVariableSystem.Toggle('cw_mil_hq_list_closed')]"
							}

							# Only armies that carry a headquarters (cw_hq_army_card hides every other unit, navies included)
							vbox = {
								visible = "[Not(GetVariableSystem.Exists('cw_mil_hq_list_closed'))]"
								layoutpolicy_horizontal = expanding
								ignoreinvisible = yes
								spacing = 4
								max_update_rate = 4

								datamodel = "[AccessPlayerUnits]"
								item = {
									cw_hq_army_card = {}
								}
							}

							text_single = {
								visible = "[And(Not(GetVariableSystem.Exists('cw_mil_hq_list_closed')), Not(GetScriptedGui('cw_sgui_player_has_hq_army').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]"
								autoresize = yes
								align = left|nobaseline
								default_format = "#subtle_name"
								text = "CW_MIL_NO_HQ_ARMIES"
							}

							divider_solid_gold = {}

							# ---- v0.7 (user review 2026-11-06): ALLIES - we only tell them what we ask; each ally decides itself ----
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 6

								text_single = {
									autoresize = yes
									align = left|nobaseline
									using = Font_Type_Headers
									default_format = "#yellow_titles"
									text = "CW_ALLIES_HEADER"
								}
								expand = {}
								button_regular = {
									size = { 120 26 }
									text = "CW_ALLIES_REFRESH"
									tooltip = "CW_ALLIES_REFRESH_TT"
									onclick = "[GetScriptedGui('cw_sgui_refresh_allies').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
							}
							text_multi = {
								layoutpolicy_horizontal = expanding
								max_width = 520
								autoresize = yes
								align = left|nobaseline
								default_format = "#overview_text"
								text = "CW_ALLIES_TEXT"
							}

							# the request to ALL allies (pressed = the last request sent to all)
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								margin = { 8 2 }
								using = bg_text_mask_container_brown

								text_single = {
									autoresize = yes
									align = left|nobaseline
									default_format = "#subtle_name"
									text = "CW_ALLIES_TO_ALL"
								}
								expand = {}
								cw_req_button = {
									blockoverride "req_props" {
										tooltip = "CW_REQ_1_TT"
										down = "[And(GetPlayer.MakeScope.GetVariable('cw_req_all_n').IsSet, Not(GreaterThan_float(FixedPointToFloat(GetPlayer.MakeScope.GetVariable('cw_req_all_n').GetValue), '(float)1.5')))]"
										onclick = "[GetScriptedGui('cw_sgui_ally_req_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									}
									blockoverride "req_icon" { texture = "gfx/interface/icons/military_stances/cw_escort_military_stance.dds" }
								}
								cw_req_button = {
									blockoverride "req_props" {
										tooltip = "CW_REQ_2_TT"
										down = "[And3(GetPlayer.MakeScope.GetVariable('cw_req_all_n').IsSet, GreaterThan_float(FixedPointToFloat(GetPlayer.MakeScope.GetVariable('cw_req_all_n').GetValue), '(float)1.5'), Not(GreaterThan_float(FixedPointToFloat(GetPlayer.MakeScope.GetVariable('cw_req_all_n').GetValue), '(float)2.5')))]"
										onclick = "[GetScriptedGui('cw_sgui_ally_req_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									}
									blockoverride "req_icon" { texture = "gfx/interface/icons/military_stances/aggressive_military_stance.dds" }
								}
								cw_req_button = {
									blockoverride "req_props" {
										tooltip = "CW_REQ_3_TT"
										down = "[And3(GetPlayer.MakeScope.GetVariable('cw_req_all_n').IsSet, GreaterThan_float(FixedPointToFloat(GetPlayer.MakeScope.GetVariable('cw_req_all_n').GetValue), '(float)2.5'), Not(GreaterThan_float(FixedPointToFloat(GetPlayer.MakeScope.GetVariable('cw_req_all_n').GetValue), '(float)3.5')))]"
										onclick = "[GetScriptedGui('cw_sgui_ally_req_3').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									}
									blockoverride "req_icon" { texture = "gfx/interface/icons/military_stances/cw_harass_military_stance.dds" }
								}
								cw_req_button = {
									blockoverride "req_props" {
										tooltip = "CW_REQ_4_TT"
										down = "[And(GetPlayer.MakeScope.GetVariable('cw_req_all_n').IsSet, GreaterThan_float(FixedPointToFloat(GetPlayer.MakeScope.GetVariable('cw_req_all_n').GetValue), '(float)3.5'))]"
										onclick = "[GetScriptedGui('cw_sgui_ally_req_4').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									}
									blockoverride "req_icon" { texture = "gfx/interface/icons/military_stances/defensive_military_stance.dds" }
								}
								cw_req_button = {
									blockoverride "req_props" {
										tooltip = "CW_REQ_0_TT"
										down = "[Not(GetPlayer.MakeScope.GetVariable('cw_req_all_n').IsSet)]"
										onclick = "[GetScriptedGui('cw_sgui_ally_req_0').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									}
									blockoverride "req_icon" { texture = "gfx/interface/icons/military_stances/normal_military_stance.dds" }
								}
							}

							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 3

								datamodel = "[GetPlayer.MakeScope.GetList('cw_war_allies')]"
								item = {
									cw_ally_row = {}
								}
							}

							text_single = {
								visible = "[IsDataModelEmpty(GetPlayer.MakeScope.GetList('cw_war_allies'))]"
								autoresize = yes
								align = left|nobaseline
								default_format = "#subtle_name"
								text = "CW_ALLIES_NONE"
							}

							divider_solid_gold = {}

							# ---- v0.6 (user review 2026-11-06): orders to VASSALS - one row per subject with its order and what it does ----
							text_single = {
								autoresize = yes
								align = left|nobaseline
								using = Font_Type_Headers
								default_format = "#yellow_titles"
								text = "CW_MIL_ORDERS_HEADER"
							}
							text_multi = {
								layoutpolicy_horizontal = expanding
								max_width = 520
								autoresize = yes
								align = left|nobaseline
								default_format = "#overview_text"
								text = "CW_MIL_ORDERS_TEXT"
							}

							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 3

								datamodel = "[Player.GetDiplomacy.GetSubjects]"
								item = {
									cw_subject_order_row = {}
								}
							}

							# one order to every subject at once (vanilla action ApplyMilitaryStanceToSubjects)
							hbox = {
								visible = "[GetScriptedGui('cw_sgui_player_has_subjects').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								layoutpolicy_horizontal = expanding
								spacing = 4
								margin = { 8 2 }
								using = bg_text_mask_container_brown

								text_single = {
									autoresize = yes
									align = left|nobaseline
									default_format = "#subtle_name"
									text = "CW_MIL_APPLY_TO_ALL"
								}

								hbox = {
									spacing = 2
