###################################
# New Intelligence: Geopolicy - "Balance of power" tab of the Geopolitics window (v0.3)
#
# Overrides the vanilla template geopolitics_tabs (in_game/gui/maritime_lateralview.gui; used by the expansion,
# expeditions, maritime and diseases lateral views) by name - the last loaded template wins, as with
# gp_disposition_tooltip.gui. A mod cannot register a lateral view of its own, so the tab opens the vanilla 'expansion'
# view and sets the GUI variable gp_balance = yes; the panel below the tabs is then shown with a minimum height larger
# than the screen, which pushes the vanilla content of the view out of sight. The vanilla tabs set gp_balance = no.
# Vanilla tab behaviour kept: texts, tooltips, the landlocked check of the maritime tab; the "Open tab" action tooltip
# is replaced by plain onclick (two onclick lines run in order, vanilla game_rules.gui / food_production_lateralview.gui).
# Data: script lists gp_bp_* on the player (gp_update_balance, in_game/common/scripted_effects/gp_region_effects.txt),
# shown with MakeScope.GetList as vanilla treasure_fleet "visited_countries". Battle mod GUI lessons: no percent sizes
# inside list items, no datamodel query inside the items of the same datamodel.
# Text: GP_BP_* (gp_geopolicy_l_*.yml), customizable_localization/gp_brief.txt (gp_bp_*).
###################################

# v0.12 a dark translucent card behind a row of the tab (same black texture as the vanilla geopolitics card header)
template gp_bp_card_bg {
	background = {
		using = color_black_texture
		texture_density = 2
		margin = { 1 1 }
		alpha = 0.35
	}
}

template geopolitics_tabs {
	header_main_tabs = { #TABS
		blockoverride "content" {
			button_main_tab_alt = {
				layoutpolicy_horizontal = expanding
				blockoverride "tab_text"{
					text = "GP_BALANCE_TAB"
				}
				tooltip = "GP_BALANCE_TAB_TT"
				onclick = "[GetVariableSystem.Set('gp_balance', 'yes')]"
				onclick = "[OpenLateralView('expansion')]"
				down = "[And(GetVariableSystem.HasValue('gp_balance', 'yes'), IsLateralViewOpened('expansion'))]"
			}

			button_main_tab_alt = {
				layoutpolicy_horizontal = expanding
				blockoverride "tab_text"{
					text = "EXPANSION_TAB"
				}
				tooltipwidget = {
					using = TabExpansionTooltip
				}
				onclick = "[GetVariableSystem.Set('gp_balance', 'no')]"
				onclick = "[OpenLateralView('expansion')]"
				down = "[And(IsLateralViewOpened('expansion'), Not(GetVariableSystem.HasValue('gp_balance', 'yes')))]"
			}

			button_main_tab_alt = {
				layoutpolicy_horizontal = expanding
				blockoverride "tab_text"{
					text = "EXPEDITIONS_TAB"
				}
				tooltipwidget = {
					using = SubTabExpeditionsTooltip
				}
				onclick = "[GetVariableSystem.Set('gp_balance', 'no')]"
				onclick = "[OpenLateralView('expeditions')]"
				down = "[IsLateralViewOpened('expeditions')]"
			}

			button_main_tab_alt = {
				layoutpolicy_horizontal = expanding
				blockoverride "tab_text"{
					text = "MARITIME_TAB"
				}
				tooltipwidget = {
					using = TabMaritimeTooltip
				}
				enabled = "[GreaterThan_CFixedPoint(Player.GetTotalCoastalPopulation, '(CFixedPoint)0')]"
				onclick = "[GetVariableSystem.Set('gp_balance', 'no')]"
				onclick = "[OpenLateralView('maritime')]"
				down = "[IsLateralViewOpened('maritime')]"
			}
		}
	}

	# ---- the Balance of power panel ----
	vbox = {
		name = "gp_balance_panel"
		visible = "[And(GetVariableSystem.HasValue('gp_balance', 'yes'), IsLateralViewOpened('expansion'))]"
		datacontext = "[Player]"
		layoutpolicy_horizontal = expanding
		minimumsize = { -1 3000 }
		using = bg_main_inner_alt
		using = window_main_tabs_margin_alt
		spacing = 6

		# ---- our region: the header card (v0.12: flag, region, a bar of our share) ----
		hbox = {
			layoutpolicy_horizontal = expanding
			minimumsize = { -1 64 }
			margin = { 8 6 }
			spacing = 10
			using = bg_card_header_01_geopolitics

			country_flag_mid = {
				datacontext = "[Player]"
			}
			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 4
				text_single = {
					layoutpolicy_horizontal = expanding
					default_format = "#yellow_titles"
					using = Font_Size_Medium
					text = "GP_BP_TITLE"
				}
				widget = {
					size = { 320 12 }
					progressbar = {
						size = { 320 12 }
						using = progress_bar_goldish
						min = 0
						max = 100
						value = "[FixedPointToFloat(Player.MakeScope.GetVariable('gp_region_pct').GetValue)]"
					}
				}
				text_single = {
					layoutpolicy_horizontal = expanding
					text = "GP_BP_OUR_SHARE"
				}
			}
		}
		text_multi = {
			layoutpolicy_horizontal = expanding
			text = "GP_BP_STATUS"
		}
		text_multi = {
			layoutpolicy_horizontal = expanding
			visible = "[Player.MakeScope.GetVariable('gp_bp_holder').IsSet]"
			text = "GP_BP_HOLDER"
		}
		text_multi = {
			layoutpolicy_horizontal = expanding
			text = "GP_BP_TENSION"
		}
		text_multi = {
			layoutpolicy_horizontal = expanding
			text = "GP_BP_RIGHT"
		}
		# v0.9 our goal (gp_goal): what our crown strives for in its scenario
		text_multi = {
			layoutpolicy_horizontal = expanding
			text = "GP_BP_GOAL"
		}
		text_multi = {
			layoutpolicy_horizontal = expanding
			visible = "[Player.MakeScope.GetVariable('gp_threat').IsSet]"
			text = "GP_BRIEF_THREAT"
		}

		# ---- the contenders of our region ----
		hbox = {
			layoutpolicy_horizontal = expanding
			minimumsize = { -1 26 }
			margin = { 8 2 }
			using = bg_card_header_01_geopolitics
			text_single = {
				default_format = "#yellow_titles"
				text = "GP_BP_CONTENDERS_TITLE"
			}
			expand = {}
		}
		# v0.12 a card per country: flag, name, share of the region as a bar (gold for a leading power, blue for the
		# rest), why it leads (gp_bp_why) and its course. Fixed sizes only inside list items (Battle GUI lessons).
		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 3
			datamodel = "[Player.MakeScope.GetList('gp_bp_contenders')]"
			item = {
				hbox = {
					layoutpolicy_horizontal = expanding
					minimumsize = { -1 58 }
					margin = { 6 4 }
					spacing = 8
					using = gp_bp_card_bg

					country_flag_mid = {
						datacontext = "[Scope.GetCountry]"
					}
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 2
						hbox = {
							layoutpolicy_horizontal = expanding
							text_single = {
								datacontext = "[Scope.GetCountry]"
								text = "GP_BP_ROW_NAME"
							}
							expand = {}
							text_single = {
								datacontext = "[Scope.GetCountry]"
								text = "GP_BP_ROW_PCT"
							}
						}
						widget = {
							datacontext = "[Scope.GetCountry]"
							size = { 300 10 }
							progressbar = {
								visible = "[Country.MakeScope.GetVariable('gp_contender').IsSet]"
								size = { 300 10 }
								using = progress_bar_goldish
								min = 0
								max = 100
								value = "[FixedPointToFloat(Country.MakeScope.GetVariable('gp_region_pct').GetValue)]"
							}
							progressbar = {
								visible = "[Not(Country.MakeScope.GetVariable('gp_contender').IsSet)]"
								size = { 300 10 }
								using = progress_bar_blue_alt
								min = 0
								max = 100
								value = "[FixedPointToFloat(Country.MakeScope.GetVariable('gp_region_pct').GetValue)]"
							}
						}
						text_multi = {
							datacontext = "[Scope.GetCountry]"
							layoutpolicy_horizontal = expanding
							fontsize = 12
							text = "GP_BP_ROW_WHY"
						}
					}
				}
			}
		}

		# ---- outside powers holding land in our region ----
		hbox = {
			layoutpolicy_horizontal = expanding
			minimumsize = { -1 26 }
			margin = { 8 2 }
			using = bg_card_header_01_geopolitics
			text_single = {
				default_format = "#yellow_titles"
				text = "GP_BP_OUTSIDERS_TITLE"
			}
			expand = {}
		}
		text_single = {
			layoutpolicy_horizontal = expanding
			visible = "[Not(Player.MakeScope.GetVariable('gp_has_intruder').IsSet)]"
			text = "GP_BP_OUTSIDERS_NOTE"
		}
		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 3
			datamodel = "[Player.MakeScope.GetList('gp_bp_outsiders')]"
			item = {
				hbox = {
					layoutpolicy_horizontal = expanding
					minimumsize = { -1 44 }
					margin = { 6 4 }
					spacing = 8
					using = gp_bp_card_bg

					country_flag_mid = {
						datacontext = "[Scope.GetCountry]"
					}
					text_multi = {
						datacontext = "[Scope.GetCountry]"
						layoutpolicy_horizontal = expanding
						text = "GP_BP_OUTSIDER_ROW"
					}
				}
			}
		}

		# ---- the macro-region ----
		hbox = {
			layoutpolicy_horizontal = expanding
			minimumsize = { -1 26 }
			margin = { 8 2 }
			using = bg_card_header_01_geopolitics
			text_single = {
				default_format = "#yellow_titles"
				text = "GP_BP_MACRO_TITLE"
			}
			expand = {}
		}
		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 3
			datamodel = "[Player.MakeScope.GetList('gp_bp_macro')]"
			item = {
				hbox = {
					layoutpolicy_horizontal = expanding
					minimumsize = { -1 40 }
					margin = { 6 4 }
					spacing = 8
					using = gp_bp_card_bg

					country_flag_small = {
						datacontext = "[Scope.GetCountry]"
					}
					text_multi = {
						datacontext = "[Scope.GetCountry]"
						layoutpolicy_horizontal = expanding
						text = "GP_BP_MACRO_ROW"
					}
				}
			}
		}

		# ---- v0.5 scenarios of the West (gp_scenarios_west.txt; customizable_localization gp_bp_sc_*) ----
		hbox = {
			layoutpolicy_horizontal = expanding
			minimumsize = { -1 26 }
			margin = { 8 2 }
			using = bg_card_header_01_geopolitics
			text_single = {
				default_format = "#yellow_titles"
				text = "GP_BP_SC_TITLE"
			}
			expand = {}
		}
		text_multi = {
			layoutpolicy_horizontal = expanding
			text = "GP_BP_SC_HYW"
		}
		text_multi = {
			layoutpolicy_horizontal = expanding
			text = "GP_BP_SC_IRELAND"
		}
		text_multi = {
			layoutpolicy_horizontal = expanding
			text = "GP_BP_SC_SCOTLAND"
		}
		text_multi = {
			layoutpolicy_horizontal = expanding
			text = "GP_BP_SC_IBERIA"
		}
		text_multi = {
			layoutpolicy_horizontal = expanding
			text = "GP_BP_SC_ITALY"
		}
		text_multi = {
			layoutpolicy_horizontal = expanding
			text = "GP_BP_SC_ITALY_SEA"
		}
		text_multi = {
			layoutpolicy_horizontal = expanding
			text = "GP_BP_SC_EMPIRE"
		}

		# ---- v0.11 the colonial stage (gp_colonies.txt; customizable_localization gp_col_*) ----
		hbox = {
			layoutpolicy_horizontal = expanding
			minimumsize = { -1 26 }
			margin = { 8 2 }
			using = bg_card_header_01_geopolitics
			text_single = {
				default_format = "#yellow_titles"
				text = "GP_COL_TITLE"
			}
			expand = {}
		}
		# v0.12 colonial ardor as a bar (0..100); the parts are in the text below
		widget = {
			visible = "[Player.MakeScope.GetVariable('gp_col_ardor').IsSet]"
			size = { 320 12 }
			progressbar = {
				size = { 320 12 }
				using = progress_bar_goldish
				min = 0
				max = 100
				value = "[FixedPointToFloat(Player.MakeScope.GetVariable('gp_col_ardor').GetValue)]"
			}
		}
		text_multi = {
			layoutpolicy_horizontal = expanding
			text = "GP_COL_ARDOR"
		}
		text_multi = {
			layoutpolicy_horizontal = expanding
			text = "GP_COL_RIGHT"
		}
		text_multi = {
			layoutpolicy_horizontal = expanding
			visible = "[Player.MakeScope.GetVariable('gp_col_empire').IsSet]"
			text = "GP_COL_EMPIRE"
		}
		text_multi = {
			layoutpolicy_horizontal = expanding
			visible = "[Player.MakeScope.GetVariable('gp_cz_rival').IsSet]"
			text = "GP_COL_RIVAL"
		}
		text_multi = {
			layoutpolicy_horizontal = expanding
			text = "GP_COL_ZONES_NOTE"
		}
		vbox = {
			layoutpolicy_horizontal = expanding
			datamodel = "[Player.MakeScope.GetList('gp_cz_mine')]"
			item = {
				text_multi = {
					datacontext = "[Scope.GetLocation]"
					layoutpolicy_horizontal = expanding
					text = "GP_COL_ZONE_ROW"
				}
			}
		}

		# ---- refresh ----
		hbox = {
			layoutpolicy_horizontal = expanding
			button_regular = {
				size = { 195 25 }
				tooltip = "GP_BP_REFRESH_TT"
				onclick = "[GetScriptedGui('gp_sgui_refresh_balance').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				text_single = {
					parentanchor = center
					text = "GP_BP_REFRESH"
				}
			}
			expand = {}
		}

		expand = {}
	}
}
