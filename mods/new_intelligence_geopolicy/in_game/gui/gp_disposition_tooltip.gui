# New Intelligence: Geopolicy - country brief in the disposition tooltip (prefix gp_)
#
# Template override: GUI templates are overwritten by name, the last loaded (mods after vanilla) wins - no vanilla
# file is replaced. Below is vanilla 1.4.7 AiDisposition_tooltip (in_game/gui/shared/government_tooltips.gui:3268)
# unchanged, plus one blockoverride "extra_tooltip_content" at the end. After a game patch: diff against vanilla.
# Text: GP_BRIEF_* (gp_geopolicy_l_*.yml) and customizable_localization/gp_brief.txt.

template AiDisposition_tooltip {
	ContextualTooltipType = {
		blockoverride "title_icon_texture" {
			texture = "[GetAiDispositionIcon(Country.Self)]"
		}
		
		blockoverride "concept_link" {
			text = "[country_disposition|e]"
		}

		blockoverride "title_button" {
			mapmode_tooltip_button = {
				datacontext = "[GetMapMode('ai_disposition_mapmode')]"
			}
		}

		blockoverride "title_text" {
			text = "[Select_CString(IsPlayerValid, Country.GetDispositionToPlayer, Localize('ai_disposition_mapmode'))]"
		}

		blockoverride "tooltip_content" {
			TooltipFlavorTextBlock = {
				visible = "[Not(IsPlayerValid)]"
				blockoverride "text" {
					text = "AI_DISPOSITION_NO_PLAYER_COUNTRY"
				}
			}

			TooltipFlavorTextBlock = {
				visible = "[IsPlayerValid]"
				blockoverride "text" {
					text = "[Country.GetDispositionToPlayerDesc]"
				}
			}

			TooltipScrolledStringPairList = {
				visible = "[And3(IsPlayerValid, Not(Country.IsLocalPlayer), Not(StringIsEmpty(Country.GetDispositionToPlayerBreakdown)))]"
				lowpriotextcontext = "[Country.GetDispositionToPlayerBreakdown]"
			}

			TooltipRowList = {
				visible = "[And3(IsPlayerValid, Not(Country.IsLocalPlayer), Not(StringIsEmpty(Country.GetDispositionToPlayerExpect)))]"
				lowpriotextcontext = "[Country.GetDispositionToPlayerExpect]"
			}

			TooltipRowList = {
				visible = "[And3(IsPlayerValid, Not(Country.IsLocalPlayer), Not(StringIsEmpty(Country.GetObjectivesDisplayText)))]"
				lowpriotextcontext = "[Country.GetObjectivesDisplayText]"
			}
		}

		# ---- New Intelligence: Geopolicy - the country brief (extra_tooltip_content is a free block of
		# ContextualTooltipType; the disposition map-mode container overrides only title_text and tooltip_content, so this
		# block shows there too) ----
		blockoverride "extra_tooltip_content" {
			TooltipFlavorTextBlock = {
				visible = "[And(Country.IsValid, Not(Country.IsLocalPlayer))]"
				blockoverride "text" {
					text = "GP_BRIEF_MAIN"
				}
			}
			TooltipFlavorTextBlock = {
				visible = "[And(Not(Country.IsLocalPlayer), Country.MakeScope.GetVariable('gp_threat').IsSet)]"
				blockoverride "text" {
					text = "GP_BRIEF_THREAT"
				}
			}
			TooltipFlavorTextBlock = {
				visible = "[And(Not(Country.IsLocalPlayer), Country.MakeScope.GetVariable('gp_war_target').IsSet)]"
				blockoverride "text" {
					text = "GP_BRIEF_TARGET"
				}
			}
		}
	}
}
